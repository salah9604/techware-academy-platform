rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isLoggedIn(){return request.auth != null;}
  function isOwner(uid){return isLoggedIn() && request.auth.uid == uid;}
  // Legacy email-key authority must use a verified email.
  function hasEmail(){return isLoggedIn() && request.auth.token.get('email','') is string && request.auth.token.get('email','').size()>0 && request.auth.token.get('email_verified',false)==true;}
  function isLegacyOwner(id){return hasEmail() && request.auth.token.email==id;}
  function uidProfileExists(){return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function legacyProfileExists(){return hasEmail() && exists(/databases/$(database)/documents/users/$(request.auth.token.email));}
  // Preserve established legacy role spelling while the portal stores normalized lowercase roles.
  function isAdmin(){return isLoggedIn() && ((uidProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin']) || (legacyProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin','Admin']));}
  function isApprovedUser(){return isLoggedIn() && ((uidProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['instructor','Instructor','admin','Admin']) || (legacyProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['instructor','Instructor','admin','Admin']));}
  function coachMatches(data,profile){return ('coachKey' in data && data.coachKey==profile.name.lower()) || ('اسم المدرب' in data && data['اسم المدرب']==profile.name);}
  function matchesCurrentCoach(data){return isLoggedIn() && ((uidProfileExists() && coachMatches(data,get(/databases/$(database)/documents/users/$(request.auth.uid)).data)) || (legacyProfileExists() && coachMatches(data,get(/databases/$(database)/documents/users/$(request.auth.token.email)).data)));}
  function hasFields(fields){return request.resource.data.keys().hasAll(fields);}
  function onlyFields(fields){return request.resource.data.keys().hasOnly(fields);}

  // Legacy collections: retained, except the self-approval and unverified-email holes.
  match /users/{userId}{
   allow get: if isOwner(userId)||isLegacyOwner(userId)||isAdmin();
   allow list: if isAdmin();
   allow create: if isOwner(userId) && hasFields(['uid','name','email','role']) && onlyFields(['uid','name','email','role'])
    && request.resource.data.uid==request.auth.uid && request.resource.data.uid==userId
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100
    && request.resource.data.email is string && request.resource.data.email==request.auth.token.email && request.resource.data.email.size()<=320
    && request.resource.data.role=='pending';
   allow update,delete: if isAdmin();
  }
  match /attendance/{id}{
   allow read: if isLoggedIn() && (resource.data.userId==request.auth.uid||isAdmin());
   allow create: if isApprovedUser() && hasFields(['userId','email','type','timestamp']) && onlyFields(['userId','email','type','timestamp','location']) && request.resource.data.userId==request.auth.uid && request.resource.data.email==request.auth.token.email && request.resource.data.type in ['حضور','انصراف'] && request.resource.data.timestamp==request.time;
   allow update: if isAdmin() && request.resource.data.userId==resource.data.userId && request.resource.data.email==resource.data.email && request.resource.data.type in ['حضور','انصراف'];
   allow delete: if isAdmin();
  }
  match /assessments/{id}{
   allow read: if isAdmin()||(isApprovedUser()&&matchesCurrentCoach(resource.data));
   allow create: if isApprovedUser() && hasFields(['coachKey','اسم المدرب','اسم الطالب','التاريخ']) && matchesCurrentCoach(request.resource.data) && request.resource.data['اسم الطالب'] is string && request.resource.data['اسم الطالب'].size()>0;
   allow update: if isAdmin()||(isApprovedUser()&&matchesCurrentCoach(resource.data)&&request.resource.data.coachKey==resource.data.coachKey&&request.resource.data['اسم المدرب']==resource.data['اسم المدرب']);
   allow delete: if isAdmin();
  }
  match /Schedules/{id}{allow read: if isApprovedUser();allow write: if isAdmin();}
  match /students/{id}{allow read: if isApprovedUser();allow write: if isAdmin();}
  match /courses/{id}{allow read: if isApprovedUser();allow write: if isAdmin();match /levels/{level}{allow read: if isApprovedUser();allow write: if isAdmin();}}
  match /rooms/{id}{allow read: if isApprovedUser();allow write: if isAdmin();}

  // Portal schema: each collection below has a strict whitelist and bounded fields.
  // IDs are Firebase Auth UIDs for users; other IDs are <=160 ASCII characters.
  // groupIds/children are admin-managed ID lists. No email/phone is stored in directory profiles.
  // Every portal record has id, version (positive integer), updatedAt (server timestamp).
  // Photos are separate <=300 KB data-URL documents, at most five per submission attempt.
  match /academyPortal/techware {
   function pathUser(uid){return /databases/$(database)/documents/academyPortal/techware/users/$(uid);}
   function me(){return get(pathUser(request.auth.uid)).data;}
   function member(){return isLoggedIn() && exists(pathUser(request.auth.uid)) && me().active==true;}
   function admin(){return member() && me().role=='admin';}
  // First portal administrator: only the verified Techware academy account may bootstrap itself.
  function isPortalBootstrapAdmin(){return isLoggedIn() && request.auth.token.get('email_verified',false)==true && request.auth.token.get('email','')=='techwareacademy@gmail.com';}
   // Existing instructors may create only their own empty portal profile on first login.
   // Their authority comes exclusively from the old protected /users collection.
   function isLegacyInstructor(){return isLoggedIn() && ((uidProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['instructor','Instructor']) || (legacyProfileExists() && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['instructor','Instructor']));}
   function role(r){return member() && me().role==r;}
   function child(sid){return role('parent') && sid in me().children;}
   function group(gid){return get(/databases/$(database)/documents/academyPortal/techware/groups/$(gid)).data;}
   function teaches(gid){return admin() || (role('instructor') && group(gid).instructorId==request.auth.uid);}
   function inGroup(gid){return admin() || (member() && (group(gid).instructorId==request.auth.uid || request.auth.uid in group(gid).studentIds || (me().role=='parent' && group(gid).studentIds.hasAny(me().children))));}
   function activeGroup(gid){return group(gid).archived==false;}
   function learner(sid){return admin() || (member() && (request.auth.uid==sid || child(sid)));}
   function text(v,max){return v is string && v.size()<=max;}
   function key(v){return v is string && v.size()>0 && v.size()<=160 && v.matches('^[A-Za-z0-9_-]+$');}
   function ids(v,max){return v is list && v.size()<=max && v.toSet().size()==v.size() && v.join('|').size()<=max*161 && v.join('|').matches('^[A-Za-z0-9_|-]*$');}
   function base(d,id,fields){return d.keys().hasOnly(fields.concat(['id','version','updatedAt'])) && d.id==id && key(id) && d.version is int && d.version>0 && d.updatedAt==request.time;}
   function next(){return request.resource.data.version==resource.data.version+1;}
   function initial(){return request.resource.data.version==1;}
   function validUser(d,id){return base(d,id,['name','role','active','children','groupIds','age','completed','completedRoboticsLevels','color']) && text(d.name,100) && d.name.size()>0 && d.role in ['admin','instructor','student','parent'] && d.active is bool && ids(d.children,8) && (d.role=='parent'||d.children.size()==0) && ids(d.groupIds,30) && d.age is int && d.age>=0 && d.age<=100 && d.completed is list && d.completed.size()<=30 && d.completed.join('|').size()<=3000 && d.completedRoboticsLevels is int && d.completedRoboticsLevels>=0 && d.completedRoboticsLevels<=100 && d.color in ['blue','pink','green','orange','violet'];}
   function validGroup(d,id){return base(d,id,['name','courseId','instructorId','studentIds','day','time','room','level','session','capacity','nextDate','archived']) && text(d.name,100) && d.name.size()>0 && key(d.courseId) && key(d.instructorId) && ids(d.studentIds,8) && d.studentIds.size()>0 && d.day in ['السبت','الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة'] && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && text(d.room,80) && d.level is int && d.level>=1 && d.level<=30 && d.session is int && d.session>=1 && d.session<=4 && d.capacity==8 && text(d.nextDate,10) && d.archived is bool;}
   function validCourse(d,id){return base(d,id,['name','track','next','color','fee']) && text(d.name,100) && text(d.track,100) && text(d.next,160) && text(d.color,20) && (d.fee==null||(d.fee is number && d.fee>=0 && d.fee<100000));}
   function validSession(d,id){return base(d,id,['groupId','courseId','level','number','date','title','summary','taskText','published']) && key(d.groupId) && d.courseId==group(d.groupId).courseId && d.level is int && d.level>=1 && d.level<=30 && d.number is int && d.number>=1 && d.number<=4 && text(d.date,10) && text(d.title,150) && text(d.summary,6000) && text(d.taskText,6000) && d.published==true;}
   function validTask(d,id){return base(d,id,['groupId','sessionId','title','description','due','required']) && key(d.groupId) && key(d.sessionId) && getAfter(/databases/$(database)/documents/academyPortal/techware/sessions/$(d.sessionId)).data.groupId==d.groupId && text(d.title,150) && text(d.description,6000) && text(d.due,10) && d.required is bool;}
   function validSubmission(d,id){return base(d,id,['groupId','taskId','studentId','text','link','fileIds','status','feedback','reviewerId','reviewedAt','reviewedAtTs','submittedAt','attempt','keepPhotos']) && key(d.groupId) && key(d.taskId) && key(d.studentId) && id==d.taskId+'_'+d.studentId && get(/databases/$(database)/documents/academyPortal/techware/tasks/$(d.taskId)).data.groupId==d.groupId && text(d.text,6000) && text(d.link,1800) && (d.link==''||d.link.matches('^https://.*')) && ids(d.fileIds,5) && d.status in ['pending','revision','complete'] && text(d.feedback,6000) && text(d.reviewerId,160) && text(d.reviewedAt,30) && (d.reviewedAtTs==null||d.reviewedAtTs is timestamp) && text(d.submittedAt,30) && d.attempt is int && d.attempt>=1 && d.attempt<=20 && d.keepPhotos is bool;}
   function ownSubmission(d){return role('student') && d.studentId==request.auth.uid && request.auth.uid in group(d.groupId).studentIds && activeGroup(d.groupId) && d.status=='pending' && d.feedback=='' && d.reviewerId=='' && d.reviewedAt=='' && d.reviewedAtTs==null && d.keepPhotos==false;}
   function validMessage(d,id){return base(d,id,['groupId','studentId','senderId','text','createdAt']) && key(d.groupId) && key(d.studentId) && d.studentId in group(d.groupId).studentIds && d.senderId==request.auth.uid && text(d.text,2000) && d.text.size()>0 && text(d.createdAt,30);}
   function validNote(d,id){return base(d,id,['groupId','studentId','text','visibility','authorId','createdAt']) && key(d.groupId) && d.studentId in group(d.groupId).studentIds && text(d.text,6000) && d.visibility in ['internal','parent'] && d.authorId==request.auth.uid && text(d.createdAt,30);}
   function validAttendance(d,id){return base(d,id,['groupId','studentId','sessionId','status']) && key(d.groupId) && d.studentId in group(d.groupId).studentIds && get(/databases/$(database)/documents/academyPortal/techware/sessions/$(d.sessionId)).data.groupId==d.groupId && d.status in ['present','absent','excused'];}
   function validEvent(d,id){return base(d,id,['title','description','date','groupId','type','createdAt']) && text(d.title,160) && text(d.description,6000) && text(d.date,10) && (d.groupId==''||key(d.groupId)) && d.type in ['holiday','change','event'] && text(d.createdAt,30);}
   function validInvoice(d,id){return base(d,id,['studentId','groupId','level','amount','due','status','paidAt','receipt']) && key(d.studentId) && key(d.groupId) && d.level is int && d.level>=1 && d.level<=30 && d.amount is number && d.amount>0 && d.amount<100000 && text(d.due,10) && d.status in ['paid','unpaid'] && text(d.paidAt,10) && text(d.receipt,100);}
   function validCompetition(d,id){return base(d,id,['title','description','date','deadline','minAge','minLevels','capacity','courseIds','closed','demo','approvedCount']) && text(d.title,160) && text(d.description,6000) && text(d.date,10) && text(d.deadline,10) && d.minAge is number && d.minAge>=4 && d.minAge<=18 && d.minLevels is number && d.minLevels>=0 && d.minLevels<=100 && d.capacity is number && d.capacity>=1 && d.capacity<=1000 && ids(d.courseIds,30) && d.closed is bool && d.demo==false && d.approvedCount is int && d.approvedCount>=0 && d.approvedCount<=d.capacity;}
   function validRegistration(d,id){return base(d,id,['competitionId','studentId','status','createdAt']) && key(d.competitionId) && key(d.studentId) && id==d.competitionId+'_'+d.studentId && d.status in ['pending_parent','pending_admin','approved'] && text(d.createdAt,30);}
   function validAudit(d,id){return base(d,id,['actorId','action','groupId','createdAt']) && d.actorId==request.auth.uid && text(d.action,300) && text(d.groupId,160) && text(d.createdAt,30);}
   match /users/{uid}{
    allow get: if isOwner(uid)||admin()||(member()&&((child(uid))||(role('instructor')&&resource.data.role=='student'&&me().groupIds.hasAny(resource.data.groupIds))||(resource.data.role=='instructor'&&me().groupIds.hasAny(resource.data.groupIds))));
    allow list: if admin();
    allow create: if initial() && validUser(request.resource.data,uid) && (admin() || (isOwner(uid)&&(isPortalBootstrapAdmin()||isAdmin())&&request.resource.data.role=='admin'&&request.resource.data.active==true&&request.resource.data.children.size()==0&&request.resource.data.groupIds.size()==0) || (isOwner(uid)&&isLegacyInstructor()&&request.resource.data.role=='instructor'&&request.resource.data.active==true&&request.resource.data.children.size()==0&&request.resource.data.groupIds.size()==0));
    allow update: if admin() && next() && validUser(request.resource.data,uid) && (uid!=request.auth.uid || (request.resource.data.role=='admin'&&request.resource.data.active==true));
    allow delete: if false;
   }
   match /groups/{id}{
    allow read: if admin()||(member()&&(resource.data.instructorId==request.auth.uid||request.auth.uid in resource.data.studentIds||(role('parent')&&resource.data.studentIds.hasAny(me().children))));
    allow create: if admin()&&initial()&&validGroup(request.resource.data,id);
    allow update: if admin()&&next()&&validGroup(request.resource.data,id);
   }
   match /courses/{id}{allow read: if member();allow create: if admin()&&initial()&&validCourse(request.resource.data,id);allow update: if admin()&&next()&&validCourse(request.resource.data,id);}
   match /sessions/{id}{allow read: if inGroup(resource.data.groupId);allow create: if teaches(request.resource.data.groupId)&&activeGroup(request.resource.data.groupId)&&initial()&&validSession(request.resource.data,id);allow update: if teaches(resource.data.groupId)&&next()&&request.resource.data.groupId==resource.data.groupId&&validSession(request.resource.data,id);}
   match /tasks/{id}{allow read: if inGroup(resource.data.groupId);allow create: if teaches(request.resource.data.groupId)&&activeGroup(request.resource.data.groupId)&&initial()&&validTask(request.resource.data,id);allow update: if teaches(resource.data.groupId)&&next()&&request.resource.data.groupId==resource.data.groupId&&request.resource.data.sessionId==resource.data.sessionId&&validTask(request.resource.data,id);}
   match /submissions/{id}{
    allow read: if teaches(resource.data.groupId)||learner(resource.data.studentId);
    allow create: if initial()&&validSubmission(request.resource.data,id)&&ownSubmission(request.resource.data)&&request.resource.data.attempt==1;
    allow update: if next() && validSubmission(request.resource.data,id) && request.resource.data.groupId==resource.data.groupId && request.resource.data.studentId==resource.data.studentId && request.resource.data.taskId==resource.data.taskId && (
     (ownSubmission(request.resource.data) && resource.data.status!='complete' && request.resource.data.attempt==resource.data.attempt+1 && request.time>=resource.data.updatedAt+duration.value(30,'s')) ||
     (teaches(resource.data.groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','feedback','reviewerId','reviewedAt','reviewedAtTs','keepPhotos','version','updatedAt']) && request.resource.data.reviewerId==request.auth.uid && request.resource.data.reviewedAtTs==request.time));
   }
   match /photos/{id}{
    function submission(){return get(/databases/$(database)/documents/academyPortal/techware/submissions/$(resource.data.submissionId)).data;}
    function validPhoto(d){let sub=getAfter(/databases/$(database)/documents/academyPortal/techware/submissions/$(d.submissionId)).data;return d.keys().hasOnly(['id','submissionId','studentId','name','dataUrl','createdAt']) && d.id==id && key(id) && key(d.submissionId) && d.studentId==request.auth.uid && sub.studentId==request.auth.uid && sub.status=='pending' && id in sub.fileIds && text(d.name,160) && d.dataUrl is string && d.dataUrl.size()<=300000 && d.dataUrl.matches('^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+$') && d.createdAt==request.time;}
    allow get: if member()&&(learner(resource.data.studentId)||teaches(submission().groupId));
    allow list: if admin();
    allow create: if role('student')&&validPhoto(request.resource.data);
    allow update: if false;
    allow delete: if admin() && submission().status=='complete' && submission().keepPhotos==false && submission().reviewedAtTs is timestamp && request.time>=submission().reviewedAtTs+duration.value(90,'d');
   }
   match /messages/{id}{allow read: if teaches(resource.data.groupId)||(role('student')&&resource.data.studentId==request.auth.uid&&inGroup(resource.data.groupId));allow create: if initial()&&validMessage(request.resource.data,id)&&activeGroup(request.resource.data.groupId)&&(teaches(request.resource.data.groupId)||(role('student')&&request.resource.data.studentId==request.auth.uid&&inGroup(request.resource.data.groupId)));}
   match /notes/{id}{allow read: if teaches(resource.data.groupId)||(child(resource.data.studentId)&&resource.data.visibility=='parent');allow create: if teaches(request.resource.data.groupId)&&initial()&&validNote(request.resource.data,id);}
   match /attendance/{id}{allow read: if teaches(resource.data.groupId)||learner(resource.data.studentId);allow create: if teaches(request.resource.data.groupId)&&initial()&&validAttendance(request.resource.data,id);allow update: if teaches(resource.data.groupId)&&next()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','updatedAt'])&&validAttendance(request.resource.data,id);}
   match /events/{id}{allow read: if member()&&(resource.data.groupId==''||inGroup(resource.data.groupId));allow create: if admin()&&initial()&&validEvent(request.resource.data,id);}
   match /invoices/{id}{allow read: if admin()||child(resource.data.studentId);allow create: if admin()&&initial()&&validInvoice(request.resource.data,id);allow update: if admin()&&next()&&validInvoice(request.resource.data,id)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paidAt','receipt','version','updatedAt']);}
   match /competitions/{id}{allow read: if member();allow create: if admin()&&initial()&&validCompetition(request.resource.data,id)&&request.resource.data.approvedCount==0;allow update: if admin()&&next()&&validCompetition(request.resource.data,id)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedCount','version','updatedAt'])&&request.resource.data.approvedCount==resource.data.approvedCount+1;}
   match /registrations/{id}{
    allow read: if learner(resource.data.studentId);
    allow create: if member()&&initial()&&validRegistration(request.resource.data,id)&&get(/databases/$(database)/documents/academyPortal/techware/competitions/$(request.resource.data.competitionId)).data.closed==false&&((role('student')&&request.resource.data.studentId==request.auth.uid&&request.resource.data.status=='pending_parent')||(child(request.resource.data.studentId)&&request.resource.data.status=='pending_admin')||(admin()&&request.resource.data.status=='pending_admin'));
    // Eligibility and capacity are checked by administration before approving a request.
    allow update: if next()&&validRegistration(request.resource.data,id)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','updatedAt'])&&((child(resource.data.studentId)&&resource.data.status=='pending_parent'&&request.resource.data.status=='pending_admin')||(admin()&&resource.data.status=='pending_admin'&&request.resource.data.status=='approved' && getAfter(/databases/$(database)/documents/academyPortal/techware/competitions/$(resource.data.competitionId)).data.approvedCount==get(/databases/$(database)/documents/academyPortal/techware/competitions/$(resource.data.competitionId)).data.approvedCount+1));
   }
   match /audit/{id}{allow read: if admin();allow create: if member()&&initial()&&validAudit(request.resource.data,id);}
   match /readMarkers/{uid}{allow read: if isOwner(uid);allow create,update: if member()&&isOwner(uid)&&request.resource.data.keys().hasOnly(['readAt'])&&request.resource.data.readAt==request.time;}
  }
  match /{document=**}{allow read,write: if false;}
 }
}
